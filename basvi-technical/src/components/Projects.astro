---
import { companyData } from '../company';

---

<section id="projects" class="py-20 bg-slate-950 text-slate-100 relative overflow-hidden">
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
      <div class="space-y-3 max-w-2xl">
        <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
          Verified Contract Track Record
        </h2>
        <p class="text-base text-slate-400 leading-relaxed">
          Every project listed below is backed by official federal/state Award Letters and Job Completion Certificates on file.
        </p>
      </div>
    </div>

    <!-- Projects Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {companyData.projects.map((project: any) => (
        <div class="bg-slate-900/90 border border-slate-800 rounded-xl p-6 flex flex-col justify-between hover:border-slate-700 transition-all duration-300 group hover:shadow-xl hover:shadow-blue-950/20">
          
          <div>
            <!-- Category & Verification Tag -->
            <div class="flex items-center justify-between gap-2 mb-4">
              <span class="text-[11px] font-semibold text-blue-400 uppercase tracking-wider bg-blue-950/80 px-2.5 py-1 rounded border border-blue-900">
                {project.category}
              </span>
              <span class="inline-flex items-center gap-1 text-[11px] font-semibold text-emerald-400 bg-emerald-950/60 px-2 py-0.5 rounded border border-emerald-900">
                <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
                Cert. On File
              </span>
            </div>

            <!-- Title & Client -->
            <h3 class="text-lg font-bold text-white group-hover:text-blue-400 transition-colors mb-2 leading-snug">
              {project.title}
            </h3>
            
            <p class="text-xs font-semibold text-slate-300 mb-1">
              Client: <span class="text-slate-400 font-normal">{project.client}</span>
            </p>
            
            <p class="text-xs text-slate-400 mb-4">
              Location: {project.location}
            </p>
          </div>

          <!-- Card Footer Metrics -->
          <div class="pt-4 border-t border-slate-800/80 flex items-center justify-between text-xs mt-4">
            <div>
              <p class="text-[10px] text-slate-500 uppercase font-medium">Contract Value</p>
              <p class="text-sm font-bold text-white">{project.value}</p>
            </div>
            <div class="text-right">
              <p class="text-[10px] text-slate-500 uppercase font-medium">Year Executed</p>
              <p class="text-xs font-semibold text-slate-300">{project.year}</p>
            </div>
          </div>

        </div>
      ))}
    </div>

    <!-- Proof Statement Footer -->
    <div class="mt-12 text-center bg-slate-900/50 border border-slate-800 rounded-xl p-6 max-w-3xl mx-auto">
      <p class="text-xs text-slate-400 leading-relaxed">
        <strong class="text-slate-200">Need formal verification?</strong> Complete BPP registration, NEMSA corporate license, Tax Clearance, and certified completion documentation are available for tender evaluation upon request.
      </p>
    </div>

  </div>
</section>