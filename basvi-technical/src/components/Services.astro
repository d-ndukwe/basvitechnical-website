---
import { companyData } from '../company';

const services = companyData.services;
---

<section id="services" class="py-20 bg-slate-900 text-slate-100 relative overflow-hidden">
  <!-- Decorative Glow Effects -->
  <div class="absolute top-0 right-1/4 w-96 h-96 bg-blue-600/10 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-0 left-1/4 w-96 h-96 bg-emerald-600/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        Certified Engineering Capabilities
      </h2>
      <p class="text-base sm:text-lg text-slate-400 leading-relaxed">
        We combine regulatory compliance, direct OEM relationships, and over two decades of technical field practice to execute complex infrastructure projects.
      </p>
    </div>

    <!-- Services Grid -->
    <div class="grid md:grid-cols-2 gap-8">
      {services.map((service: any, index: number) => (
        <div class="bg-slate-800/80 border border-slate-700/80 rounded-2xl p-8 hover:border-blue-500/50 transition-all duration-300 hover:shadow-xl hover:shadow-blue-950/40 flex flex-col justify-between group">
          
          <div>
            <!-- Header with Numbering -->
            <div class="flex items-center justify-between mb-6">
              <span class="text-xs font-bold font-mono px-3 py-1 rounded bg-blue-950 text-blue-400 border border-blue-800/60">
                0{index + 1}
              </span>
              <span class="text-xs font-semibold text-slate-400 uppercase tracking-widest">
                NEMSA / COREN Compliant
              </span>
            </div>

            <!-- Service Title & Description -->
            <h3 class="text-2xl font-bold text-white group-hover:text-blue-400 transition-colors mb-2">
              {service.title}
            </h3>
            <p class="text-xs font-medium text-blue-400 mb-4">
              {service.subtitle}
            </p>
            <p class="text-sm text-slate-300 leading-relaxed mb-6">
              {service.description}
            </p>

            <!-- Capabilities List -->
            <div class="border-t border-slate-700/60 pt-6 space-y-3">
              <p class="text-xs font-bold text-slate-400 uppercase tracking-wider">Key Capabilities:</p>
              <ul class="space-y-2.5">
                {service.capabilities.map((item: string) => (
                  <li class="flex items-start gap-3 text-xs sm:text-sm text-slate-300">
                    <svg class="w-4 h-4 text-emerald-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <!-- Bottom Card Footer CTA -->
          <div class="mt-8 pt-6 border-t border-slate-700/60 flex items-center justify-between">
            <a 
              href="#contact" 
              class="inline-flex items-center gap-2 text-xs font-bold text-blue-400 hover:text-blue-300 transition-colors group/link"
            >
              <span>Consult on {service.title.split(' ')[0]} Project</span>
              <svg class="w-4 h-4 transform group-hover/link:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>

        </div>
      ))}
    </div>

    <!-- Trust Banner Bottom -->
    <div class="mt-16 bg-slate-800/40 border border-slate-700/50 rounded-2xl p-6 sm:p-8 text-center sm:flex sm:items-center sm:justify-between gap-6">
      <div class="text-left space-y-1 mb-4 sm:mb-0">
        <h4 class="text-base font-bold text-white">Need a custom technical engineering survey?</h4>
        <p class="text-xs sm:text-sm text-slate-400">Our COREN-certified team prepares comprehensive BEME & site evaluation reports.</p>
      </div>
      <a 
        href="#contact" 
        class="inline-block px-6 py-3 bg-blue-600 hover:bg-blue-500 text-white text-xs font-bold rounded-lg transition-all shadow-md shrink-0"
      >
        Schedule Site Survey
      </a>
    </div>

  </div>
</section>