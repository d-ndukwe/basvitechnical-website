---
import { companyData } from '../company';
---

<section id="team" class="py-20 bg-slate-900 text-slate-100 relative overflow-hidden">
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        Executive Leadership & Key Engineers
      </h2>
      <p class="text-base text-slate-400 leading-relaxed">
        Led by COREN-certified engineers with over 70 combined years of hands-on experience in power generation, grid distribution, and civil engineering infrastructure.
      </p>
    </div>

    <!-- Leadership Grid -->
    <div class="grid md:grid-cols-2 gap-8">
      {companyData.leadership.map((member: any) => (
        <div class="bg-slate-800/80 border border-slate-700/80 rounded-2xl p-8 hover:border-blue-500/50 transition-all duration-300 flex flex-col justify-between group">
          
          <div>
            <!-- Header: Name & Role -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-4 border-b border-slate-700/80 mb-6">
              <div>
                <h3 class="text-xl font-bold text-white group-hover:text-blue-400 transition-colors">
                  {member.name}
                </h3>
                <p class="text-xs font-semibold text-blue-400 uppercase tracking-wider mt-0.5">
                  {member.role}
                </p>
              </div>
              <span class="px-3 py-1 text-[11px] font-bold bg-slate-900 text-emerald-400 border border-emerald-900/60 rounded-full shrink-0 w-fit">
                {member.experience}
              </span>
            </div>

            <!-- Qualifications Badge -->
            <div class="mb-4">
              <span class="inline-block text-xs font-medium text-slate-300 bg-slate-900/90 px-3 py-1.5 rounded-lg border border-slate-700/60">
                🎓 {member.qualifications}
              </span>
            </div>

            <!-- Bio & Specialty -->
            <p class="text-sm text-slate-300 leading-relaxed mb-4">
              {member.bio}
            </p>
          </div>

          <!-- Specialty Footer -->
          <div class="pt-4 border-t border-slate-700/60 mt-4">
            <p class="text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-1">Core Specialty:</p>
            <p class="text-xs font-semibold text-slate-200">{member.specialty}</p>
          </div>

        </div>
      ))}
    </div>

    <!-- Council Regulatory Banner -->
    <div class="mt-12 bg-slate-950/60 border border-slate-800 rounded-xl p-6 text-center max-w-4xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="text-left space-y-1">
        <p class="text-sm font-bold text-white">COREN & NEMSA Practice Compliance</p>
        <p class="text-xs text-slate-400">All engineering designs, BEME calculations, and field installations are vetted under strict COREN statutory standards.</p>
      </div>
      <span class="text-xs font-mono font-bold text-blue-400 bg-blue-950/80 px-4 py-2 rounded-lg border border-blue-800 shrink-0">
        NEMSA Cert: CC/CEIF/PR/03377
      </span>
    </div>

  </div>
</section>